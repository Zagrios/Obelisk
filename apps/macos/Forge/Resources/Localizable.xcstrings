{
  "sourceLanguage": "en",
  "strings": {
    "backend.steam.runtime.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam launch cancelled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancement Steam annulé."
          }
        }
      }
    },
    "backend.steam.runtime.invalidSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect your Steam account before launching this game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez votre compte Steam avant de lancer ce jeu."
          }
        }
      }
    },
    "backend.steam.runtime.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Steam runtime bundled with Forge is unavailable. Reinstall Forge to restore its files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam fourni avec Forge est indisponible. Réinstallez Forge pour restaurer ses fichiers."
          }
        }
      }
    },
    "backend.steam.runtime.versionMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the Steam runtime is not supported yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du moteur Steam n’est pas encore prise en charge."
          }
        }
      }
    },
    "backend.steam.runtime.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu démarrer."
          }
        }
      }
    },
    "backend.steam.runtime.authenticationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not sign in to your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu se connecter à votre compte."
          }
        }
      }
    },
    "backend.steam.runtime.ownershipFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam could not confirm your license for this game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam n’a pas pu confirmer votre licence pour ce jeu."
          }
        }
      }
    },
    "backend.steam.runtime.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam took too long to prepare the game. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a mis trop de temps à préparer le jeu. Réessayez."
          }
        }
      }
    },
    "backend.steam.runtime.storageFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge could not prepare the local Steam runtime files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge n’a pas pu préparer les fichiers locaux du moteur Steam."
          }
        }
      }
    },
    "backend.steam.runtime.apiMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge could not find a supported Steamworks library in this game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge n’a pas trouvé de bibliothèque Steamworks compatible dans ce jeu."
          }
        }
      }
    },
