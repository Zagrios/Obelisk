    "ui.launch_settings.arguments_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden bei jedem Start nach den eigenen Argumenten des Spiels angefügt. Setzen Sie ein Argument mit Leerzeichen in doppelte Anführungszeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added after the game's own arguments each time it starts. Put an argument with spaces in double quotes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se añaden después de los argumentos propios del juego cada vez que se inicia. Pon entre comillas dobles un argumento que contenga espacios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés après les arguments du jeu à chaque lancement. Mettez un argument qui contient des espaces entre guillemets doubles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunti dopo gli argomenti del gioco a ogni avvio. Metti tra virgolette doppie un argomento con spazi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起動のたびに、ゲーム自身の引数の後に追加されます。スペースを含む引数は、二重引用符で囲んでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "São adicionadas depois dos argumentos do próprio jogo a cada inicialização. Coloque entre aspas duplas um argumento que contenha espaços."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次启动时添加在游戏自身的参数之后。包含空格的参数请用双引号括起来。"
          }
        }
      }
    },
