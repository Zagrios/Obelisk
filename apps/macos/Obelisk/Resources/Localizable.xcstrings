    "backend.steam.cloud.conflict": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der lokale Speicherstand und der in der Cloud haben sich beide geändert. Wählen Sie, welche Version verwendet werden soll."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local and Cloud saves have both changed. Choose which version to use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Han cambiado tanto las partidas guardadas locales como las de Cloud. Elige qué versión usar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes locales et Cloud ont toutes deux changé. Choisissez la version à utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi locali e quelli nel cloud sono cambiati entrambi. Scegli quale versione usare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルとクラウドのセーブデータが両方とも変更されています。使用するデータを選択してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos salvos locais e os da nuvem foram alterados. Escolha qual versão usar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地存档和云存档都已更改。请选择要使用的版本。"
          }
        }
      }
    },
    "backend.steam.cloud.storage": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Speicherstände konnten nicht sicher archiviert oder überprüft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saves could not be safely archived or verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron archivar o verificar las partidas guardadas de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes n’ont pas pu être archivées ou vérifiées en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile archiviare o verificare i salvataggi in modo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セーブデータを安全にアーカイブまたは検証できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
