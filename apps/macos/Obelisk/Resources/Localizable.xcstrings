    "ui.settings.report_bug_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sagen Sie den Entwicklern, was schiefgelaufen ist, mit den Protokollen von %@, wenn Sie einverstanden sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell the developers what went wrong, with %@'s logs if you agree."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuenta a los desarrolladores qué ha fallado, con los registros de %@ si estás de acuerdo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expliquez aux développeurs ce qui ne va pas, avec les logs d’%@ si vous le souhaitez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Racconta agli sviluppatori cosa è andato storto, con i log di %@ se sei d'accordo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発生した問題を開発者にお知らせください。同意いただければ、%@のログも添付されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conte aos desenvolvedores o que deu errado, com os registros do %@ se você concordar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉开发者出了什么问题，如果您同意，可附上 %@ 的日志。"
          }
        }
      }
    },
