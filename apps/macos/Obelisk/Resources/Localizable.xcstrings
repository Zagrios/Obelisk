    "backend.steam.runtime.timeout": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam took too long to prepare the game. Please try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a mis trop de temps à préparer le jeu. Réessayez."
          }
        }
      }
    },
    "backend.steam.runtime.storageFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not prepare the local Steam runtime files."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk n’a pas pu préparer les fichiers locaux du moteur Steam."
          }
        }
