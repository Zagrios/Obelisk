    "backend.steam.components.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk konnte die Steam-Komponenten, die Steam-Spiele benötigen, nicht von Valve herunterladen. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not download from Valve the Steam components Steam games need. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk no pudo descargar de Valve los componentes de Steam que necesitan los juegos de Steam. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk n'a pas pu télécharger depuis Valve les composants Steam dont les jeux Steam ont besoin. Vérifiez votre connexion et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk non ha potuto scaricare da Valve i componenti Steam necessari ai giochi Steam. Controlla la connessione e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamゲームに必要なSteamコンポーネントを、ObeliskがValveからダウンロードできませんでした。ネットワーク接続を確認して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obelisk não conseguiu baixar da Valve os componentes do Steam de que os jogos Steam precisam. Verifique a sua conexão e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 无法从 Valve 下载 Steam 游戏所需的 Steam 组件。请检查网络连接后重试。"
          }
        }
      }
    },
    "backend.steam.components.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
