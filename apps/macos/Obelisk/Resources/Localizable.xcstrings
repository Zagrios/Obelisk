            "state": "translated",
            "value": "Die Startdatei des Spiels ist nicht ausführbar. Überprüfen Sie seine Dateien erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game’s launch file is not executable. Verify its files again."
