    "ui.launch_settings.ray_tracing_detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games that support DirectX 12 ray tracing can turn it on in their own settings. Turn this off for a game that crashes or renders wrongly with it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux qui gèrent le ray tracing DirectX 12 peuvent l'activer dans leurs propres réglages. Désactivez cette option pour un jeu qui plante ou s'affiche mal avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giochi che supportano il ray tracing di DirectX 12 possono attivarlo nelle proprie impostazioni. Disattivalo per un gioco che si blocca o mostra errori grafici con il ray tracing."
          }
        }
      }
    },
