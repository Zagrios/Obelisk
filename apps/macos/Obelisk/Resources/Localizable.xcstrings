    "ui.settings.update_automatically": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Update games automatically"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour les jeux automatiquement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiorna i giochi automaticamente"
          }
        }
      }
    },
    "ui.settings.update_automatically_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads each update as soon as it is published, one game at a time. Updates wait while a game is running, whatever its store, and one in progress resumes afterwards. When off, a game updates when you launch it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge chaque mise à jour dès sa publication, un jeu à la fois. Les mises à jour attendent pendant une partie, quelle que soit la boutique du jeu, et celle en cours reprend ensuite. Désactivé, un jeu se met à jour quand vous le lancez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica ogni aggiornamento non appena viene pubblicato, un gioco alla volta. Gli aggiornamenti restano in attesa mentre un gioco è in esecuzione, qualunque sia il suo store, e quello in corso riprende dopo. Se disattivato, un gioco si aggiorna quando lo avvii."
          }
        }
      }
    },
    "ui.settings.share_performance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share game performance"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les performances des jeux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi le prestazioni dei giochi"
          }
        }
      }
    },
    "ui.settings.share_performance_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a game closes, sends its frame rate, how it ended and your Mac's chip to getobelisk.app, which shows how each game runs on each Mac. Nothing in it identifies you."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un jeu se ferme, envoie sa fréquence d'images, la façon dont il s'est terminé et la puce de votre Mac à getobelisk.app, qui montre comment chaque jeu tourne sur chaque Mac. Rien de tout cela ne vous identifie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un gioco si chiude, invia il suo frame rate, come è finito e il chip del tuo Mac a getobelisk.app, che mostra come gira ogni gioco su ogni Mac. Nulla di ciò che invia ti identifica."
          }
        }
      }
    },
