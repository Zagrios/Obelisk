          }
        }
      }
    },
    "ui.settings.update_automatically_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt jedes Update, sobald es veröffentlicht wird, ein Spiel nach dem anderen. Updates warten, solange ein Spiel läuft, egal aus welchem Shop, und ein laufendes wird danach fortgesetzt. Wenn deaktiviert, wird ein Spiel aktualisiert, sobald Sie es starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads each update as soon as it is published, one game at a time. Updates wait while a game is running, whatever its store, and one in progress resumes afterwards. When off, a game updates when you launch it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga cada actualización en cuanto se publica, un juego cada vez. Las actualizaciones esperan mientras haya un juego en ejecución, sea de la tienda que sea, y la que esté en curso se reanuda después. Si está desactivado, un juego se actualiza cuando lo inicias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge chaque mise à jour dès sa publication, un jeu à la fois. Les mises à jour attendent pendant une partie, quelle que soit la boutique du jeu, et celle en cours reprend ensuite. Désactivé, un jeu se met à jour quand vous le lancez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica ogni aggiornamento non appena viene pubblicato, un gioco alla volta. Gli aggiornamenti restano in attesa mentre un gioco è in esecuzione, qualunque sia il suo store, e quello in corso riprende dopo. Se disattivato, un gioco si aggiorna quando lo avvii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートが公開されるとすぐに、1本ずつダウンロードします。ストアを問わず、ゲームの実行中はアップデートを待機し、進行中のアップデートはその後に再開します。オフの場合、ゲームは起動時にアップデートされます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cada atualização assim que é publicada, um jogo de cada vez. As atualizações aguardam enquanto houver um jogo em execução, seja qual for a loja, e a que estiver em andamento é retomada depois. Quando desativado, o jogo é atualizado quando você o inicia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新一经发布即下载，每次一款游戏。无论来自哪个商店，只要有游戏正在运行，更新都会等待，进行中的更新会在之后继续。关闭后，游戏会在您启动时更新。"
          }
        }
      }
    },
    "ui.settings.share_performance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielleistung teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share game performance"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartir el rendimiento de los juegos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partager les performances des jeux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi le prestazioni dei giochi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームのパフォーマンスを共有"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhar o desempenho dos jogos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享游戏性能"
          }
        }
      }
    },
    "ui.settings.share_performance_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendet beim Beenden eines Spiels dessen Bildrate, wie es beendet wurde und den Chip Ihres Macs an getobelisk.app, wo zu sehen ist, wie jedes Spiel auf jedem Mac läuft. Nichts davon identifiziert Sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a game closes, sends its frame rate, how it ended and your Mac's chip to getobelisk.app, which shows how each game runs on each Mac. Nothing in it identifies you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando se cierra un juego, envía su velocidad de fotogramas, cómo terminó y el chip de tu Mac a getobelisk.app, que muestra cómo funciona cada juego en cada Mac. Nada de ello te identifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un jeu se ferme, envoie sa fréquence d'images, la façon dont il s'est terminé et la puce de votre Mac à getobelisk.app, qui montre comment chaque jeu tourne sur chaque Mac. Rien de tout cela ne vous identifie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando un gioco si chiude, invia il suo frame rate, come è finito e il chip del tuo Mac a getobelisk.app, che mostra come gira ogni gioco su ogni Mac. Nulla di ciò che invia ti identifica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームの終了時に、フレームレート、終了の状況、お使いのMacのチップをgetobelisk.appに送信します。このサイトでは、各ゲームがそれぞれのMacでどのように動作するかを確認できます。個人を特定できる情報は含まれません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um jogo é fechado, envia a taxa de quadros, como ele terminou e o chip do seu Mac para getobelisk.app, que mostra como cada jogo roda em cada Mac. Nada disso identifica você."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏关闭时，将其帧率、结束方式和您 Mac 的芯片发送到 getobelisk.app，该网站会展示每款游戏在每种 Mac 上的运行情况。其中不含任何可识别您身份的信息。"
          }
        }
      }
    },
    "ui.settings.downloads": {
