      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk is checking whether the Epic game is still running. Keep its installed files unchanged."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk vérifie si le jeu Epic est encore en cours. Conservez ses fichiers installés en attendant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
