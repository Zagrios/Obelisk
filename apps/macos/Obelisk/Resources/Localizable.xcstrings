    "backend.epic.cloud.recovery": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk prüft, ob das Epic-Spiel noch läuft. Lassen Sie die installierten Dateien unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk is checking whether the Epic game is still running. Keep its installed files unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk está comprobando si el juego de Epic sigue en ejecución. No modifiques sus archivos instalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk vérifie si le jeu Epic est encore en cours. Conservez ses fichiers installés en attendant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk sta controllando se il gioco Epic è ancora in esecuzione. Non modificare i suoi file installati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ObeliskがEpicゲームの実行状況を確認しています。インストール済みのファイルは変更しないでください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obelisk está verificando se o jogo da Epic ainda está em execução. Não altere os arquivos instalados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 正在检查 Epic 游戏是否仍在运行。请不要更改其已安装的文件。"
          }
        }
      }
    },
    "backend.epic.cloud.storage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk konnte die Speicherstände dieses Spiels nicht sicher lesen oder archivieren. Prüfen Sie den freien Speicherplatz und den Ordnerzugriff und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not safely read or archive this game’s saves. Check available disk space and folder access, then retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk no pudo leer o archivar de forma segura las partidas guardadas de este juego. Comprueba el espacio disponible en disco y el acceso a la carpeta, y reinténtalo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk n’a pas pu lire ou archiver les sauvegardes de ce jeu en toute sécurité. Vérifiez l’espace disque et l’accès aux dossiers, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk non ha potuto leggere o archiviare in sicurezza i salvataggi di questo gioco. Controlla lo spazio su disco e l'accesso alle cartelle, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeliskがこのゲームのセーブデータを安全に読み取り、またはアーカイブできませんでした。ディスクの空き容量とフォルダーへのアクセス権を確認して、もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obelisk não conseguiu ler ou arquivar com segurança os jogos salvos deste jogo. Verifique o espaço disponível em disco e o acesso à pasta e tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 无法安全地读取或归档此游戏的存档。请检查可用磁盘空间和文件夹访问权限，然后重试。"
          }
        }
      }
    },
    "backend.epic.cloud.failed": {
