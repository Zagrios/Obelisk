    "ui.game.closing_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel wurde aufgefordert, sich zu beenden. Wenn es nicht reagiert, können Sie es in ein paar Sekunden sofort beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game was asked to quit. If it does not respond, you can force it to quit in a few seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha pedido al juego que se cierre. Si no responde, podrás forzar su salida en unos segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu a été invité à quitter. S’il ne répond pas, vous pourrez le forcer à quitter dans quelques secondes."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al gioco è stato chiesto di chiudersi. Se non risponde, tra qualche secondo potrai forzare l'uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームに終了を要求しました。応答がない場合は、数秒後に強制終了できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Foi solicitado que o jogo se encerre. Se ele não responder, você poderá forçar o encerramento em alguns segundos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已要求游戏退出。如果它没有响应，几秒后您可以强制退出。"
          }
        }
      }
    },
    "ui.game.force_quit_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Spiel reagiert nicht: Beenden Sie es sofort. Alles, was es nicht gespeichert hat, geht verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The game is not responding: force it to quit. Anything it has not saved is lost."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El juego no responde: fuerza su salida. Se perderá todo lo que no haya guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jeu ne répond pas : forcez-le à quitter. Ce qu’il n’a pas enregistré sera perdu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il gioco non risponde: forza l'uscita. Tutto ciò che non ha salvato andrà perso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームが応答していません。強制終了してください。保存されていない内容は失われます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo não está respondendo: force o encerramento. Tudo o que ele não salvou será perdido."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏没有响应：请强制退出。游戏尚未保存的内容将会丢失。"
          }
        }
      }
    },
    "ui.game.force_quit_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was das Spiel nicht gespeichert hat, geht verloren."
          }
