    "backend.steam.chat.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is empty."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est vide."
          }
        }
      }
    },
    "backend.steam.chat.invalidRecipient": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Steam account cannot receive messages."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Steam ne peut pas recevoir de messages."
          }
        }
      }
    },
    "backend.steam.chat.notFriends": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only message your Steam friends."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez écrire qu’à vos amis Steam."
          }
        }
      }
    },
    "backend.steam.chat.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam is limiting messages. Try again in a moment."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam limite les messages. Réessayez dans un instant."
          }
        }
      }
    },
