    "ui.overlay.purchase.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bittet Steam, einen Kauf im Spiel zu autorisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ asks Steam to authorize an in-game purchase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pide a Steam que autorice una compra dentro del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ demande à Steam d’autoriser un achat dans le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ chiede a Steam di autorizzare un acquisto nel gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が、ゲーム内購入の承認をSteamに求めています。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pede ao Steam que autorize uma compra dentro do jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 请求 Steam 授权一笔游戏内购买。"
          }
        }
      }
    },
    "ui.overlay.purchase.charge": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk kann den Preis nicht anzeigen: Prüfen Sie das Angebot im Spiel. Wenn Sie es autorisieren, belastet Steam das Steam-Guthaben oder die Zahlungsmethode Ihres Accounts so, wie es das Angebot des Spiels angibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk cannot show its price: check the offer in the game. If you authorize it, Steam charges your account’s Steam Wallet or payment method as the game’s offer states."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk no puede mostrar el precio: comprueba la oferta en el juego. Si la autorizas, Steam cargará el importe en la Cartera de Steam o en el método de pago de tu cuenta, según indique la oferta del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk ne peut pas en afficher le prix : vérifiez l’offre dans le jeu. Si vous l’autorisez, Steam débite le portefeuille Steam ou le moyen de paiement de votre compte selon l’offre du jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk non può mostrarne il prezzo: controlla l'offerta nel gioco. Se la autorizzi, Steam addebita sul Portafoglio Steam o sul metodo di pagamento del tuo account, come indicato dall'offerta del gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeliskでは価格を表示できません。ゲーム内で購入内容をご確認ください。承認すると、ゲーム内の表示のとおり、アカウントのSteamウォレットまたはお支払い方法にSteamから請求されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obelisk não pode mostrar o preço: confira a oferta no jogo. Se você autorizar, o Steam cobrará da Carteira Steam ou da forma de pagamento da sua conta, conforme indicado na oferta do jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 无法显示其价格：请在游戏中查看该商品。如果您授权，Steam 将按游戏中所示，从您帐户的 Steam 钱包或付款方式中扣款。"
          }
        }
      }
    },
