    "backend.runtime.wineUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine, das Windows-Spiele ausführt, ist nicht installiert. Starten Sie das Spiel erneut, um es zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine, which runs Windows games, is not installed. Launch the game again to install it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine, que ejecuta los juegos de Windows, no está instalado. Vuelve a iniciar el juego para instalarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Wine, qui fait tourner les jeux Windows, n'est pas installé. Relancez le jeu pour l'installer."
