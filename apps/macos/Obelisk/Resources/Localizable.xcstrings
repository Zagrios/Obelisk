    "ui.games_folder.stays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps your saves and your Windows games’ environments on this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ garde vos sauvegardes et les environnements de vos jeux Windows sur ce Mac."
          }
        }
      }
    },
    "ui.games_folder.read_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is read-only: choose a folder on another disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est en lecture seule : choisissez un dossier sur un autre disque."
          }
        }
      }
    },
    "ui.games_folder.no_space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough space on “%1$@”: %2$@ to copy, %3$@ available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d’espace sur « %1$@ » : %2$@ à copier, %3$@ disponibles."
          }
        }
      }
    },
    "ui.games_folder.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is formatted as %2$@. Games can be installed there, but it is slower with some of them and can be damaged if it is unplugged without being ejected. APFS suits a disk used only with Macs best."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est formaté en %2$@. Les jeux peuvent s’y installer, mais il est plus lent avec certains et peut s’abîmer s’il est débranché sans être éjecté. APFS convient mieux à un disque utilisé seulement avec des Mac."
          }
        }
      }
    },
    "ui.games_folder.move": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Games"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les jeux"
          }
        }
      }
    },
