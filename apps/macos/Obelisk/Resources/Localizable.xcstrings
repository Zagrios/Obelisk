    "backend.steam.cloud.network": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steam Cloud ist nicht erreichbar. Ihre lokalen Speicherstände bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam Cloud is unreachable. Your local saves are preserved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con Steam Cloud. Tus partidas guardadas locales se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam Cloud est inaccessible. Vos sauvegardes locales sont conservées."
          }
        },
        "it": {
