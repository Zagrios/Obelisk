    "backend.steam.achievements.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam hat widersprüchliche Daten zu den Errungenschaften geliefert. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam returned inconsistent achievement data. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam devolvió datos de logros incoherentes. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a renvoyé des données de succès incohérentes. Réessaie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ha restituito dati sugli obiettivi incoerenti. Riprova."
