          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未安装用于运行 Windows 游戏的 Wine。请重新启动游戏以进行安装。"
          }
        }
      }
    },
    "backend.voile.downloadFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk konnte Wine, das Windows-Spiele ausführt, nicht herunterladen. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not download Wine, which runs Windows games. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk no pudo descargar Wine, que ejecuta los juegos de Windows. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
