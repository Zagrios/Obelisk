    "ui.settings.games_folder_disconnected": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Laufwerk ist nicht verbunden: Seine Spiele werden als nicht installiert angezeigt, bis es wieder da ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its disk is not connected: its games show as not installed until it comes back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su disco no está conectado: sus juegos aparecen como no instalados hasta que vuelva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son disque n’est pas connecté : ses jeux apparaissent comme non installés jusqu’à son retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo disco non è collegato: i suoi giochi risultano non installati finché non torna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダーのディスクが接続されていません。再び接続されるまで、ここにあるゲームは未インストールとして表示されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O disco dela não está conectado: os jogos aparecem como não instalados até ele voltar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其磁盘未连接：在重新连接之前，其中的游戏会显示为未安装。"
          }
        }
      }
