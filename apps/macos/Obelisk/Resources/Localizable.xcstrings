    "ui.settings.overlay_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie während eines Spiels das %1$@-Overlay, um Ihre Freunde und Errungenschaften zu erreichen, ohne das Spiel zu verlassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "During a game, open the %1$@ overlay to reach your friends and achievements without leaving it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una partida, abre la interfaz superpuesta de %1$@ para acceder a tus amigos y logros sin salir del juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pendant une partie, ouvrez l’overlay d’%1$@ pour retrouver vos amis et vos succès sans quitter le jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante una partita, apri l'overlay di %1$@ per raggiungere i tuoi amici e i tuoi obiettivi senza uscire dal gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲーム中に%1$@オーバーレイを開くと、ゲームを離れずにフレンドや実績を確認できます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante um jogo, abra o painel do %1$@ para acessar os seus amigos e as suas conquistas sem sair dele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏过程中，打开 %1$@ 游戏内叠加界面即可查看好友和成就，无需离开游戏。"
          }
        }
      }
    },
