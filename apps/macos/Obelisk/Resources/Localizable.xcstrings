    "ui.report.open_issue_help": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet das Fehlerformular von GitHub mit diesem Bericht ausgefüllt. Ein Issue ist öffentlich; Ihre Protokolle und Ihr Kontakt bleiben privat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens GitHub's bug form with this report filled in. An issue is public; your logs and contact stay private."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el formulario de errores de GitHub con este informe ya rellenado. Una incidencia es pública; tus registros y tu contacto siguen siendo privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre le formulaire de bug de GitHub, rempli avec ce rapport. Une issue est publique, vos logs et votre contact restent privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il modulo dei bug di GitHub con questa segnalazione già compilata. Una issue è pubblica; i tuoi log e il tuo contatto restano privati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この報告を入力した状態で、GitHubの不具合報告フォームを開きます。Issueは公開されますが、ログと連絡先は非公開のままです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o formulário de erros do GitHub com este relato já preenchido. Uma issue é pública; os seus registros e o seu contato continuam privados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 GitHub 的错误表单并填入此报告。issue 是公开的；您的日志和联系方式仍保持私密。"
          }
        }
      }
    },
