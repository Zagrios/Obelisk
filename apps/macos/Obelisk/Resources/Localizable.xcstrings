    "model.steam.sessionMayRestore": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Die gespeicherte Sitzung wird Ihnen beim nächsten Öffnen der App möglicherweise wieder angeboten."
