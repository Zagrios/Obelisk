      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its disk is not connected: its games show as not installed until it comes back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son disque n’est pas connecté : ses jeux apparaissent comme non installés jusqu’à son retour."
          }
        }
      }
    }
