    "ui.game.delete_download_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bisher heruntergeladenen Dateien werden gelöscht. Ein erneuter Download des Spiels beginnt von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files downloaded so far will be deleted. Downloading the game again will start over."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los archivos descargados hasta ahora. Si vuelves a descargar el juego, empezará desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers déjà téléchargés seront supprimés. Un nouveau téléchargement du jeu repartira de zéro."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file scaricati finora verranno eliminati. Scaricare di nuovo il gioco ripartirà da capo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これまでにダウンロードしたファイルが削除されます。このゲームをもう一度ダウンロードする場合は、最初からやり直しになります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos baixados até agora serão excluídos. Se você baixar o jogo novamente, o download começará do zero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
