    "ui.launch_settings.ray_tracing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spielen Raytracing anbieten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offer ray tracing to games"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ofrecer trazado de rayos a los juegos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer le ray tracing aux jeux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Offri il ray tracing ai giochi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームにレイトレーシングを提供"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Oferecer ray tracing aos jogos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为游戏提供光线追踪"
          }
        }
      }
    },
    "ui.launch_settings.ray_tracing_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiele, die DirectX-12-Raytracing unterstützen, können es in ihren eigenen Einstellungen aktivieren. Deaktivieren Sie dies für ein Spiel, das damit abstürzt oder fehlerhaft dargestellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Games that support DirectX 12 ray tracing can turn it on in their own settings. Turn this off for a game that crashes or renders wrongly with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los juegos compatibles con el trazado de rayos de DirectX 12 pueden activarlo en sus propios ajustes. Desactívalo para un juego que se cierre o se vea mal con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jeux qui gèrent le ray tracing DirectX 12 peuvent l'activer dans leurs propres réglages. Désactivez cette option pour un jeu qui plante ou s'affiche mal avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giochi che supportano il ray tracing di DirectX 12 possono attivarlo nelle proprie impostazioni. Disattivalo per un gioco che si blocca o mostra errori grafici con il ray tracing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DirectX 12のレイトレーシングに対応しているゲームは、ゲーム内の設定で有効にできます。有効にするとクラッシュしたり表示が乱れたりするゲームでは、この設定をオフにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos compatíveis com o ray tracing do DirectX 12 podem ativá-lo nas próprias configurações. Desative esta opção para um jogo que trave ou apresente falhas de imagem com ele."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 DirectX 12 光线追踪的游戏可以在自己的设置中开启。如果游戏因此崩溃或画面异常，请关闭此项。"
          }
        }
      }
    },
