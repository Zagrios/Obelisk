    "backend.steam.runtime.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam launch cancelled."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancement Steam annulé."
          }
        }
      }
    },
    "backend.steam.runtime.invalidSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect your Steam account before launching this game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez votre compte Steam avant de lancer ce jeu."
          }
        }
      }
    },
    "backend.steam.runtime.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Steam components Obelisk launches games with are unavailable. Launch the game again, or reinstall Obelisk if this persists."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les composants Steam avec lesquels Obelisk lance les jeux sont indisponibles. Relancez le jeu, ou réinstallez Obelisk si le problème persiste."
          }
        }
      }
    },
    "backend.steam.runtime.versionMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the Steam runtime is not supported yet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du moteur Steam n’est pas encore prise en charge."
          }
        }
      }
    },
    "backend.steam.runtime.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not start."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu démarrer."
          }
        }
      }
    },
    "backend.steam.windowsSteam.signInRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam for Windows isn't signed in. Sign in to it in this game's Launch Settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam pour Windows n’est pas connecté. Connectez-le dans les réglages de lancement de ce jeu."
          }
        }
      }
    },
    "backend.steam.windowsSteam.signInFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam for Windows didn't take the sign-in. Try again."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam pour Windows n’a pas accepté la connexion. Réessayez."
          }
        }
      }
    },
    "backend.steam.runtime.authenticationFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not sign in to your account."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu se connecter à votre compte."
          }
        }
      }
