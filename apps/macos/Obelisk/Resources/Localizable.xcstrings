    },
    "ui.games_folder.moves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed game moves there, in Downloads. It cannot be played while it moves."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed games move there one at a time, in Downloads. A game cannot be played while it moves; the others can."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeu installé y sera déplacé, dans les téléchargements. Il ne peut pas être lancé pendant son déplacement."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeux installés y seront déplacés un par un, dans les téléchargements. Un jeu ne peut pas être lancé pendant son déplacement ; les autres, si."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld gioco installato si sposta lì, nei Download. Non può essere avviato mentre si sposta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld giochi installati si spostano lì uno alla volta, nei Download. Un gioco non può essere avviato mentre si sposta; gli altri sì."
                }
              }
            }
          }
        }
      }
    },
    "ui.games_folder.space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ to copy · %2$@ available on this disk"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ à copier · %2$@ disponibles sur ce disque"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ da copiare · %2$@ disponibili su questo disco"
          }
        }
      }
    },
    "ui.games_folder.installs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ installs your games there from now on."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y installera désormais vos jeux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "D'ora in poi %1$@ installa lì i tuoi giochi."
          }
        }
      }
    },
    "ui.games_folder.stays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps your saves and your Windows games’ environments on this Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ garde vos sauvegardes et les environnements de vos jeux Windows sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene su questo Mac i tuoi salvataggi e gli ambienti dei tuoi giochi Windows."
          }
        }
      }
    },
    "ui.games_folder.read_only": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is read-only: choose a folder on another disk."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est en lecture seule : choisissez un dossier sur un autre disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è in sola lettura: scegli una cartella su un altro disco."
          }
        }
      }
    },
    "ui.games_folder.no_space": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough space on “%1$@”: %2$@ to copy, %3$@ available."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez d’espace sur « %1$@ » : %2$@ à copier, %3$@ disponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente su «%1$@»: %2$@ da copiare, %3$@ disponibili."
          }
        }
      }
    },
    "ui.games_folder.format": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is formatted as %2$@. Games can be installed there, but it is slower with some of them and can be damaged if it is unplugged without being ejected. APFS suits a disk used only with Macs best."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est formaté en %2$@. Les jeux peuvent s’y installer, mais il est plus lent avec certains et peut s’abîmer s’il est débranché sans être éjecté. APFS convient mieux à un disque utilisé seulement avec des Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è formattato in %2$@. I giochi Windows ci si installano, ma alcuni giochi Mac potrebbero no: ExFAT e FAT non contengono link, che i giochi Mac usano, e FAT nessun file da 4 GB in su. Può anche danneggiarsi se viene scollegato senza essere espulso. APFS è il più adatto a un disco usato solo con i Mac."
          }
        }
      }
    },
    "ui.games_folder.move": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move Games"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer les jeux"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta i giochi"
          }
        }
      }
    },
    "ui.games_folder.use": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use This Folder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser ce dossier"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa questa cartella"
          }
        }
      }
    },
    "ui.settings.games_folder_disconnected": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its disk is not connected: its games show as not installed until it comes back."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son disque n’est pas connecté : ses jeux apparaissent comme non installés jusqu’à son retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo disco non è collegato: i suoi giochi risultano non installati finché non torna."
          }
        }
      }
    }
  },
