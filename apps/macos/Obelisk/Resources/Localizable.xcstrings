    "ui.rosetta.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Spiel benötigt Rosetta, um auf Ihrem Mac zu laufen. macOS wird die Installation anbieten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game requires Rosetta to run on your Mac. macOS will offer to install it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este juego necesita Rosetta para funcionar en tu Mac. macOS te ofrecerá instalarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jeu nécessite Rosetta pour fonctionner sur votre Mac. macOS va vous proposer son installation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gioco richiede Rosetta per funzionare sul tuo Mac. macOS ti proporrà di installarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームをMacで実行するには、Rosettaが必要です。macOSがインストールを案内します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este jogo precisa do Rosetta para rodar no seu Mac. O macOS vai oferecer a instalação."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此游戏需要 Rosetta 才能在您的 Mac 上运行。macOS 将提示您安装。"
          }
        }
      }
    },
