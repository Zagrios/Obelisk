    "ui.games_folder.moves": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installiertes Spiel wird dorthin verschoben, unter Downloads. Es kann nicht gespielt werden, während es verschoben wird."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installierte Spiele werden nacheinander dorthin verschoben, unter Downloads. Ein Spiel kann nicht gespielt werden, während es verschoben wird; die anderen schon."
                }
              }
            }
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed game moves there, in Downloads. It cannot be played while it moves."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed games move there one at a time, in Downloads. A game cannot be played while it moves; the others can."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld juego instalado se mueve allí, en Descargas. No se puede jugar mientras se mueve."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld juegos instalados se mueven allí de uno en uno, en Descargas. No se puede jugar a un juego mientras se mueve; a los demás, sí."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeu installé y sera déplacé, dans les téléchargements. Il ne peut pas être lancé pendant son déplacement."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeux installés y seront déplacés un par un, dans les téléchargements. Un jeu ne peut pas être lancé pendant son déplacement ; les autres, si."
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld gioco installato si sposta lì, nei Download. Non può essere avviato mentre si sposta."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld giochi installati si spostano lì uno alla volta, nei Download. Un gioco non può essere avviato mentre si sposta; gli altri sì."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "インストール済みの%lld本のゲームが、「ダウンロード」でそこに移動されます。移動中はプレイできません。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "インストール済みの%lld本のゲームが、「ダウンロード」で1本ずつそこに移動されます。移動中のゲームはプレイできませんが、ほかのゲームはプレイできます。"
                }
              }
            }
          }
        },
        "pt-BR": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jogo instalado será movido para lá, em Downloads. Não é possível jogá-lo enquanto ele é movido."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jogos instalados serão movidos para lá, um de cada vez, em Downloads. Não é possível jogar um jogo enquanto ele é movido; os outros, sim."
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 款已安装的游戏将在“下载”中移到那里。移动期间无法游玩。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld 款已安装的游戏将在“下载”中逐个移到那里。游戏在移动期间无法游玩，其他游戏不受影响。"
                }
              }
