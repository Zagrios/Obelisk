          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente su «%1$@»: %2$@ da copiare, %3$@ disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」の空き容量が足りません：コピー %2$@、空き容量 %3$@。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há espaço suficiente em “%1$@”: %2$@ a copiar, %3$@ disponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”空间不足：需复制 %2$@，可用 %3$@。"
          }
        }
      }
    },
    "ui.games_folder.format": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ ist als %2$@ formatiert. Spiele können dort installiert werden, aber es ist bei manchen langsamer und kann beschädigt werden, wenn es ohne Auswerfen getrennt wird. APFS eignet sich am besten für ein Laufwerk, das nur mit Macs verwendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” is formatted as %2$@. Games can be installed there, but it is slower with some of them and can be damaged if it is unplugged without being ejected. APFS suits a disk used only with Macs best."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» tiene formato %2$@. Se pueden instalar juegos ahí, pero con algunos es más lento y puede dañarse si se desconecta sin expulsarlo. APFS es lo más adecuado para un disco que solo se usa con Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %1$@ » est formaté en %2$@. Les jeux peuvent s’y installer, mais il est plus lent avec certains et peut s’abîmer s’il est débranché sans être éjecté. APFS convient mieux à un disque utilisé seulement avec des Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» è formattato in %2$@. I giochi Windows ci si installano, ma alcuni giochi Mac potrebbero no: ExFAT e FAT non contengono link, che i giochi Mac usano, e FAT nessun file da 4 GB in su. Può anche danneggiarsi se viene scollegato senza essere espulso. APFS è il più adatto a un disco usato solo con i Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」は%2$@でフォーマットされています。ゲームをインストールできますが、一部のゲームでは動作が遅くなり、取り出さずに取り外すと破損するおそれがあります。Macだけで使用するディスクには、APFSが最適です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” está formatado como %2$@. É possível instalar jogos nele, mas alguns ficam mais lentos e o disco pode ser danificado se for desconectado sem ser ejetado. O APFS é o mais indicado para um disco usado apenas com Macs."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@”的格式为 %2$@。可以在上面安装游戏，但部分游戏会较慢，且未推出就拔出可能导致损坏。对于只在 Mac 上使用的磁盘，APFS 最为合适。"
          }
        }
      }
    },
