    "ui.games_folder.title_mac": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your games back to this Mac?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ramener vos jeux sur ce Mac ?"
