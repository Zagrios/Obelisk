            "value": "Das HUD von Metal zeigt die Bildrate und die Dauer jedes Bildes über dem Spiel an, egal welches Backend es rendert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal's HUD shows the frame rate and the time of each frame over the game, whichever backend renders it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El HUD de Metal muestra sobre el juego la velocidad de fotogramas y el tiempo de cada fotograma, sea cual sea el backend que lo renderice."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le panneau de Metal affiche les images par seconde et la durée de chaque image par-dessus le jeu, quel que soit le moteur GPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'HUD di Metal mostra sul gioco il frame rate e il tempo di ogni fotogramma, qualunque sia il backend che lo disegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのバックエンドで描画している場合でも、MetalのHUDがフレームレートと各フレームの所要時間をゲーム画面に表示します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O HUD do Metal mostra sobre o jogo a taxa de quadros e o tempo de cada quadro, seja qual for o backend que o renderiza."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无论使用哪个后端渲染，Metal 的 HUD 都会在游戏画面上显示帧率和每帧耗时。"
          }
        }
      }
    },
