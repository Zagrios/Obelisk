            "value": "Aggiorna i giochi automaticamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームを自動的にアップデート"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar jogos automaticamente"
          }
