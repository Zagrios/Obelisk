    "backend.steam.invite.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game cannot send an invitation right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeu ne peut pas envoyer d’invitation pour le moment."
          }
        }
