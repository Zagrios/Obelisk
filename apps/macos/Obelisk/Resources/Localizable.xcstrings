    "app.update.running.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Obelisk aktualisieren, wird das Spiel gestoppt. Seine Cloud-Speicherstände werden synchronisiert, bevor Obelisk neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating Obelisk stops the game. Its Cloud saves are synced before Obelisk restarts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al actualizar Obelisk se detiene el juego. Sus partidas guardadas en Cloud se sincronizan antes de que Obelisk se reinicie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour Obelisk arrête le jeu. Ses sauvegardes Cloud sont synchronisées avant qu’Obelisk ne redémarre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornando Obelisk il gioco viene fermato. I suoi salvataggi cloud vengono sincronizzati prima che Obelisk si riavvii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeliskをアップデートすると、ゲームも停止します。クラウドセーブは、Obeliskが再起動する前に同期されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Atualizar o Obelisk interrompe o jogo. Os salvamentos na nuvem são sincronizados antes de o Obelisk reiniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新 Obelisk 会停止游戏。Obelisk 重启前会同步其云存档。"
          }
        }
      }
    },
