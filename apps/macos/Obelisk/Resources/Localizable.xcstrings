    "backend.epic.friends.forbidden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic hat den Zugriff auf Freunde oder deren Status verweigert. Ihre Bibliothek ist weiterhin verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic denied access to friends or presence. Your library is still available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic denegó el acceso a los amigos o a su estado. Tu biblioteca sigue disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic a refusé l’accès aux amis ou aux présences. Votre bibliothèque reste disponible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic ha negato l'accesso agli amici o alla presenza. La tua libreria è comunque disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Epicがフレンドまたはオンライン状況へのアクセスを拒否しました。ライブラリは引き続きご利用いただけます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Epic negou o acesso aos amigos ou ao status deles. A sua biblioteca continua disponível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic 拒绝了对好友或在线状态的访问。您的库仍然可用。"
          }
        }
      }
    },
