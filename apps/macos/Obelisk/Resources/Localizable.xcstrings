    "backend.runtime.macBuildNotNative": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Mac-Version läuft nicht nativ auf Apple Silicon. Deinstallieren Sie das Spiel und installieren Sie es dann erneut: Obelisk installiert die Windows-Version, wenn der Shop eine anbietet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac build does not run natively on Apple silicon. Uninstall the game, then install it again: Obelisk will install its Windows build if the store has one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión para Mac no funciona de forma nativa en Apple Silicon. Desinstala el juego y vuelve a instalarlo: Obelisk instalará su versión de Windows si la tienda tiene una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version Mac ne fonctionne pas nativement sur Apple silicon. Désinstallez le jeu, puis installez-le de nouveau : Obelisk installera sa version Windows si la boutique en propose une."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione per Mac non gira in modo nativo su Apple silicon. Disinstalla il gioco, poi installalo di nuovo: Obelisk installerà la versione Windows se lo store ne ha una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMac版はAppleシリコンでネイティブに動作しません。ゲームをアンインストールしてから、もう一度インストールしてください。ストアにWindows版がある場合は、ObeliskがWindows版をインストールします。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão para Mac não roda nativamente em Apple Silicon. Desinstale o jogo e instale-o novamente: o Obelisk instalará a versão para Windows se a loja tiver uma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Mac 版本无法在 Apple 芯片上原生运行。请卸载游戏后重新安装：如果商店提供 Windows 版本，Obelisk 将安装该版本。"
          }
        }
      }
    },
    "backend.install.macBuildNotNative": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mac-Version dieses Spiels läuft nicht nativ auf Apple Silicon, und der Shop bietet keine Windows-Version davon an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
