          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O jogo perdeu a conexão com o Steam. Ele continua em execução."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "游戏已失去与 Steam 的连接，但仍在运行。"
          }
        }
      }
    },
    "model.steam.gameHostLost": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steam-Laufzeit ist nicht verfügbar. Beenden Sie das Spiel normal, bevor Sie es erneut starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Steam runtime is unavailable. Close the game normally before launching it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno de Steam no está disponible. Cierra el juego con normalidad antes de volver a iniciarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam est indisponible. Fermez le jeu normalement avant de le relancer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il runtime di Steam non è disponibile. Chiudi normalmente il gioco prima di riavviarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamランタイムを利用できません。もう一度起動する前に、ゲームを通常どおり終了してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
