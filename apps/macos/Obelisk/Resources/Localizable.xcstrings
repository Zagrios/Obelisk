    "ui.game.uninstall_message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die installierten Spieldateien werden gelöscht. Sie können das Spiel jederzeit wieder aus Ihrer Bibliothek herunterladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The installed game files will be deleted. You can download the game again from your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán los archivos instalados del juego. Puedes volver a descargarlo desde tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers installés du jeu seront supprimés. Vous pourrez télécharger à nouveau le jeu depuis votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file installati del gioco verranno eliminati. Potrai scaricare di nuovo il gioco dalla tua libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みのゲームファイルが削除されます。ゲームはライブラリからもう一度ダウンロードできます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
