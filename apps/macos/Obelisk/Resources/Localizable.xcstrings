    "backend.epic.friends.presenceForbidden": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic hat Ihre Freunde geliefert, aber den Zugriff auf ihren anfänglichen Status verweigert. Manche Status sind möglicherweise nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic returned your friends but denied access to their initial presence. Some statuses may be unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic devolvió tus amigos, pero denegó el acceso a su estado inicial. Puede que algunos estados no estén disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic a renvoyé vos amis, mais refuse l’accès à leur présence initiale. Certains statuts peuvent être indisponibles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic ha restituito i tuoi amici ma ha negato l'accesso al loro stato iniziale. Alcuni stati potrebbero non essere disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Epicからフレンドは返されましたが、最初のオンライン状況へのアクセスは拒否されました。一部のステータスを表示できない場合があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Epic retornou os seus amigos, mas negou o acesso ao status inicial deles. Alguns status podem estar indisponíveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Epic 返回了您的好友，但拒绝了对其初始在线状态的访问。部分状态可能不可用。"
          }
        }
      }
    },
    "model.steam.otherGameRunning": {
      "extractionState": "manual",
      "localizations": {
        "de": {
