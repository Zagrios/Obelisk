    "ui.settings.install_updates_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lädt jede neue Version von %1$@ im Hintergrund und installiert sie, wenn Sie die App beenden. Wenn deaktiviert, fragt %1$@ vor dem Download nach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads each new version of %1$@ in the background and installs it when you quit. When off, %1$@ asks before downloading it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga cada nueva versión de %1$@ en segundo plano y la instala al salir. Si está desactivado, %1$@ pregunta antes de descargarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharge chaque nouvelle version d’%1$@ en arrière-plan et l’installe quand vous le quittez. Désactivé, %1$@ demande avant de la télécharger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica in background ogni nuova versione di %1$@ e la installa quando esci. Se disattivato, %1$@ chiede prima di scaricarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@の新しいバージョンをバックグラウンドでダウンロードし、終了時にインストールします。オフの場合、%1$@はダウンロードの前に確認します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa cada nova versão do %1$@ em segundo plano e a instala quando você sai. Quando desativado, o %1$@ pergunta antes de baixá-la."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在后台下载 %1$@ 的每个新版本，并在您退出时安装。关闭后，%1$@ 会在下载前询问。"
          }
        }
      }
    },
