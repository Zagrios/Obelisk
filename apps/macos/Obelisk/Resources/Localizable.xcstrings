    "ui.launch_settings.game_mode_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gibt dem Spiel im Vollbildmodus Vorrang vor Hintergrundaufgaben. Deaktivieren Sie dies für ein Spiel, das damit langsamer läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gives the game priority over background tasks while it is full screen. Turn this off for a game that runs slower with it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS da prioridad al juego sobre las tareas en segundo plano mientras está a pantalla completa. Desactívalo para un juego que vaya más lento con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS donne la priorité au jeu sur les tâches en arrière-plan tant qu'il est en plein écran. Désactivez cette option pour un jeu qui tourne moins vite avec."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS dà priorità al gioco rispetto alle attività in background mentre è a schermo intero. Disattivala per un gioco che gira più lentamente con la Modalità Gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フルスクリーン表示中は、macOSがバックグラウンドタスクよりもゲームを優先します。有効にすると動作が遅くなるゲームでは、この設定をオフにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O macOS dá prioridade ao jogo sobre as tarefas em segundo plano enquanto ele está em tela cheia. Desative esta opção para um jogo que fique mais lento com ela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时，macOS 会优先运行游戏，而非后台任务。如果游戏因此变慢，请关闭此项。"
          }
        }
      }
    },
    "ui.launch_settings.next_launch": {
