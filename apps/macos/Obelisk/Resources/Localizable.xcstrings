    "ui.games_folder.moves": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed game moves there, in Downloads. It cannot be played while it moves."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld installed games move there one at a time, in Downloads. A game cannot be played while it moves; the others can."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeu installé y sera déplacé, dans les téléchargements. Il ne peut pas être lancé pendant son déplacement."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld jeux installés y seront déplacés un par un, dans les téléchargements. Un jeu ne peut pas être lancé pendant son déplacement ; les autres, si."
                }
              }
            }
          }
        }
      }
    },
    "ui.games_folder.space": {
      "extractionState": "manual",
