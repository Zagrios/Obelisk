    "ui.settings.beta_releases_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erhalten Sie sofort die neuesten Beta-Versionen von %1$@ und Voile. Betas sind noch nicht getestet und können Fehler enthalten: Wenn Sie einen finden, melden Sie ihn bitte. Deaktivieren Sie dies, um zu den stabilen Versionen zurückzukehren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the latest beta versions of %1$@ and Voile right away. Betas are not tested yet and may have bugs: if you find one, please report it. Turn this off to go back to the stable versions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibe de inmediato las últimas versiones beta de %1$@ y Voile. Las betas aún no se han probado y pueden tener errores: si encuentras alguno, infórmanos. Desactívalo para volver a las versiones estables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevez directement les dernières versions bêta d’%1$@ et de Voile. Attention : elles ne sont pas encore testées et peuvent contenir des bugs. Si c’est le cas, signalez-les-nous. Désactivez l’option pour revenir aux versions stables."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi subito le ultime versioni beta di %1$@ e Voile. Attenzione: non sono ancora testate e possono contenere bug. Se ne trovi, segnalaceli. Disattiva l’opzione per tornare alle versioni stabili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@とVoileの最新ベータ版をすぐに入手できます。ベータ版は十分にテストされておらず、不具合が含まれる場合があります。不具合を見つけた場合は、ぜひご報告ください。安定版に戻すには、この設定をオフにしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receba imediatamente as versões beta mais recentes do %1$@ e do Voile. As betas ainda não foram testadas e podem ter erros: se encontrar algum, relate-o, por favor. Desative para voltar às versões estáveis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一时间获取 %1$@ 和 Voile 的最新测试版。测试版尚未经过测试，可能存在错误：如果您发现错误，请报告。关闭此项即可回到稳定版。"
          }
        }
      }
    },
