    "ui.chat.invitePicker.sentHelp": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam bestätigt nicht, dass die Einladung angekommen ist. Wenn bei Ihrem Freund nichts ankommt, teilen Sie den Beitrittscode des Spiels, falls es einen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam doesn’t confirm that the invitation arrived. If your friend gets nothing, share the game’s join code if it has one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam no confirma que la invitación haya llegado. Si tu amigo no recibe nada, comparte el código para unirse a la partida, si el juego tiene uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ne confirme pas la réception de l’invitation. Si votre ami ne reçoit rien, partagez le code de la partie si le jeu en propose un."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam non conferma che l'invito sia arrivato. Se il tuo amico non riceve nulla, condividi il codice di partecipazione del gioco, se ne ha uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamは招待が届いたかどうかを通知しません。フレンドに届いていない場合は、ゲームに参加コードがあれば、そちらを共有してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam não confirma se o convite chegou. Se o seu amigo não receber nada, compartilhe o código de entrada da partida, se o jogo tiver um."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 不会确认邀请是否送达。如果好友没有收到，请分享游戏的加入代码（如果有）。"
          }
        }
      }
    },
    "ui.chat.invitePicker.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Steam-Chat stellt die Verbindung wieder her. Sie können erneut einladen, sobald er zurück ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam chat is reconnecting. You can invite again once it’s back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El chat de Steam se está reconectando. Podrás volver a invitar cuando esté disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chat Steam se reconnecte. Vous pourrez inviter dès son retour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
