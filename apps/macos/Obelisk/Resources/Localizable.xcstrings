{
  "sourceLanguage": "en",
  "strings": {
    "backend.steam.chat.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nachricht ist leer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The message is empty."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje está vacío."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le message est vide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il messaggio è vuoto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージが空です。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A mensagem está vazia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "消息为空。"
          }
        }
      }
    },
    "backend.steam.chat.invalidRecipient": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Steam-Account kann keine Nachrichten empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Steam account cannot receive messages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta cuenta de Steam no puede recibir mensajes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce compte Steam ne peut pas recevoir de messages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo account Steam non può ricevere messaggi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このSteamアカウントはメッセージを受信できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta conta Steam não pode receber mensagens."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此 Steam 帐户无法接收消息。"
          }
        }
      }
    },
    "backend.steam.chat.notFriends": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können nur Ihren Steam-Freunden schreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can only message your Steam friends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo puedes escribir a tus amigos de Steam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous ne pouvez écrire qu’à vos amis Steam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi scrivere solo ai tuoi amici di Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを送信できるのはSteamフレンドのみです。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você só pode enviar mensagens para os seus amigos Steam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您只能向 Steam 好友发送消息。"
          }
        }
      }
    },
    "backend.steam.chat.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam begrenzt gerade Nachrichten. Versuchen Sie es gleich noch einmal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam is limiting messages. Try again in a moment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam está limitando los mensajes. Inténtalo de nuevo en un momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam limite les messages. Réessayez dans un instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam sta limitando i messaggi. Riprova tra poco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamがメッセージの送信を制限しています。しばらくしてからもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam está limitando as mensagens. Tente novamente em instantes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 正在限制消息发送，请稍后重试。"
          }
        }
      }
    },
    "backend.steam.cm.action.chat": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "die Chat-Anfrage"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "the chat request"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "la solicitud de chat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "la requête de discussion"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "la richiesta della chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットリクエスト"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "a solicitação de conversa"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天请求"
          }
        }
      }
    },
    "backend.steam.invite.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr Spiel kann gerade keine Einladung senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your game cannot send an invitation right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu juego no puede enviar una invitación ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre jeu ne peut pas envoyer d’invitation pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo gioco non può inviare un invito in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、このゲームから招待を送信できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seu jogo não pode enviar um convite no momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的游戏目前无法发送邀请。"
          }
        }
      }
    },
    "backend.steam.join.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesem Spiel kann gerade nicht beigetreten werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game cannot be joined right now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es posible unirse a esta partida ahora mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie ne peut pas être rejointe pour le moment."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile unirsi a questo gioco in questo momento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、このゲームには参加できません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível entrar nesta partida no momento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前无法加入此游戏。"
          }
        }
      }
    },
    "backend.steam.runtime.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam-Start abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam launch cancelled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicio de Steam cancelado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancement Steam annulé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvio di Steam annullato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamの起動をキャンセルしました。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicialização do Steam cancelada."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 启动已取消。"
          }
        }
      }
    },
    "backend.steam.runtime.invalidSession": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie Ihren Steam-Account erneut, bevor Sie dieses Spiel starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect your Steam account before launching this game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar tu cuenta de Steam antes de iniciar este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez votre compte Steam avant de lancer ce jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnetti il tuo account Steam prima di avviare questo gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このゲームを起動する前に、Steamアカウントに再接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte a sua conta Steam antes de iniciar este jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先重新连接您的 Steam 帐户，再启动此游戏。"
          }
        }
      }
    },
    "backend.steam.runtime.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steam-Komponenten, mit denen Obelisk Spiele startet, sind nicht verfügbar. Starten Sie das Spiel erneut oder installieren Sie Obelisk neu, falls das Problem bestehen bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Steam components Obelisk launches games with are unavailable. Launch the game again, or reinstall Obelisk if this persists."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los componentes de Steam con los que Obelisk inicia los juegos no están disponibles. Vuelve a iniciar el juego o reinstala Obelisk si el problema continúa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les composants Steam avec lesquels Obelisk lance les jeux sont indisponibles. Relancez le jeu, ou réinstallez Obelisk si le problème persiste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I componenti Steam con cui Obelisk avvia i giochi non sono disponibili. Avvia di nuovo il gioco, oppure reinstalla Obelisk se il problema persiste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeliskがゲームの起動に使用するSteamコンポーネントを利用できません。ゲームをもう一度起動してください。問題が解決しない場合は、Obeliskを再インストールしてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os componentes do Steam que o Obelisk usa para iniciar jogos estão indisponíveis. Inicie o jogo novamente ou reinstale o Obelisk se o problema persistir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 启动游戏所需的 Steam 组件不可用。请重新启动游戏；如果问题仍然存在，请重新安装 Obelisk。"
          }
        }
      }
    },
    "backend.steam.runtime.versionMismatch": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Version der Steam-Laufzeit wird noch nicht unterstützt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This version of the Steam runtime is not supported yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión del entorno de Steam aún no es compatible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version du moteur Steam n’est pas encore prise en charge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione del runtime di Steam non è ancora supportata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのSteamランタイムにはまだ対応していません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do ambiente de execução do Steam ainda não é compatível."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚不支持此版本的 Steam 运行时。"
          }
        }
      }
    },
    "backend.steam.runtime.startFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Steam-Laufzeit konnte nicht gestartet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el entorno nativo de Steam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu démarrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare il runtime nativo di Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブのSteamランタイムを起動できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar o ambiente de execução nativo do Steam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Steam 运行时无法启动。"
          }
        }
      }
    },
    "backend.steam.runtime.authenticationFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die native Steam-Laufzeit konnte sich nicht bei Ihrem Account anmelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The native Steam runtime could not sign in to your account."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El entorno nativo de Steam no pudo iniciar sesión en tu cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur Steam natif n’a pas pu se connecter à votre compte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il runtime nativo di Steam non è riuscito ad accedere al tuo account."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブのSteamランタイムがアカウントにログインできませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ambiente de execução nativo do Steam não conseguiu iniciar a sessão na sua conta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生 Steam 运行时无法登录您的帐户。"
          }
        }
      }
    },
    "backend.steam.runtime.ownershipFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam konnte Ihre Lizenz für dieses Spiel nicht bestätigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam could not confirm your license for this game."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam no pudo confirmar tu licencia de este juego."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam n’a pas pu confirmer votre licence pour ce jeu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam non ha potuto confermare la tua licenza per questo gioco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamがこのゲームのライセンスを確認できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam não conseguiu confirmar a sua licença deste jogo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 无法确认您对此游戏的许可。"
          }
        }
      }
    },
    "backend.steam.runtime.timeout": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam hat zu lange gebraucht, um das Spiel vorzubereiten. Bitte versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam took too long to prepare the game. Please try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam tardó demasiado en preparar el juego. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam a mis trop de temps à préparer le jeu. Réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ha impiegato troppo tempo a preparare il gioco. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Steamによるゲームの準備に時間がかかりすぎました。もう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam demorou demais para preparar o jogo. Tente novamente."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 准备游戏的时间过长，请重试。"
          }
        }
      }
    },
    "backend.steam.runtime.storageFailed": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk konnte die lokalen Dateien der Steam-Laufzeit nicht vorbereiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not prepare the local Steam runtime files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk no pudo preparar los archivos locales del entorno de Steam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk n’a pas pu préparer les fichiers locaux du moteur Steam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk non ha potuto preparare i file locali del runtime di Steam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ObeliskがローカルのSteamランタイムファイルを準備できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Obelisk não conseguiu preparar os arquivos locais do ambiente de execução do Steam."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk 无法准备本地的 Steam 运行时文件。"
          }
        }
      }
    },
    "backend.steam.runtime.apiMissing": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk konnte in diesem Spiel keine unterstützte Steamworks-Bibliothek finden."
