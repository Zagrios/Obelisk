    "app.quit.running.message": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn Sie Obelisk beenden, wird das Spiel gestoppt. Seine Cloud-Speicherstände werden synchronisiert, bevor Obelisk beendet wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitting Obelisk stops the game. Its Cloud saves are synced before Obelisk quits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al salir de Obelisk se detiene el juego. Sus partidas guardadas en Cloud se sincronizan antes de que Obelisk se cierre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quitter Obelisk arrête le jeu. Ses sauvegardes Cloud sont synchronisées avant qu’Obelisk ne se ferme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscendo da Obelisk il gioco viene fermato. I suoi salvataggi cloud vengono sincronizzati prima che Obelisk si chiuda."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obeliskを終了すると、ゲームも停止します。クラウドセーブは、Obeliskが終了する前に同期されます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sair do Obelisk interrompe o jogo. Os salvamentos na nuvem são sincronizados antes de o Obelisk fechar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 Obelisk 会停止游戏。Obelisk 退出前会同步其云存档。"
          }
        }
      }
    },
