    "backend.steam.cloud.authentication": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie den Account erneut, dem diese Speicherstände gehören, um sie zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect the account that owns these saves to synchronize them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectar la cuenta a la que pertenecen estas partidas guardadas para sincronizarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez le compte propriétaire de ces sauvegardes pour les synchroniser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnetti l'account a cui appartengono questi salvataggi per sincronizzarli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期するには、これらのセーブデータを所有するアカウントに再接続してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconecte a conta à qual pertencem estes jogos salvos para sincronizá-los."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新连接拥有这些存档的帐户以进行同步。"
          }
        }
      }
    },
    "backend.steam.cloud.preferences": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Synchronisation ist deaktiviert oder ihre Einstellungen konnten nicht überprüft werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud synchronization is disabled or its preferences could not be verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con Cloud está desactivada o no se pudieron verificar sus preferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Cloud est désactivée ou ses préférences n’ont pas pu être vérifiées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione cloud è disattivata oppure non è stato possibile verificarne le preferenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド同期が無効になっているか、その設定を確認できませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com a nuvem está desativada ou não foi possível verificar as preferências dela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云同步已停用，或无法验证其偏好设置。"
          }
        }
      }
    },
    "backend.steam.cloud.unsupported": {
      "localizations": {
        "de": {
