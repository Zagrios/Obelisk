    "ui.settings.games_moving_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie werden nacheinander unter Downloads verschoben. Ein Spiel kann nicht gespielt werden, während es verschoben wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They move one at a time in Downloads. A game cannot be played while it moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se mueven de uno en uno en Descargas. No se puede jugar a un juego mientras se mueve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils sont déplacés un par un dans les téléchargements. Un jeu ne peut pas être lancé pendant son déplacement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si spostano uno alla volta nei Download. Un gioco non può essere avviato mentre si sposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゲームは「ダウンロード」で1本ずつ移動されます。移動中のゲームはプレイできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles são movidos um de cada vez em Downloads. Não é possível jogar um jogo enquanto ele é movido."
