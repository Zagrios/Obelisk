    "ui.settings.downloads_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Begrenzt sofort, was alle Shops herunterladen, und legt die Einheit fest, in der Geschwindigkeiten angezeigt werden. Mbit/s bedeutet Megabit pro Sekunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Limits what every store downloads, right away, and sets the unit speeds read in. Mbps means megabits per second."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita de inmediato lo que descargan todas las tiendas y define la unidad en la que se muestran las velocidades. Mbps significa megabits por segundo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite ce que téléchargent toutes les boutiques, immédiatement, et choisit l’unité des vitesses. Mbps signifie mégabits par seconde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita ciò che scaricano tutti gli store, subito, e sceglie l’unità delle velocità. Mbps indica megabit al secondo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのストアのダウンロード速度をすぐに制限し、速度の表示単位を設定します。Mbpsはメガビット毎秒を表します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limita imediatamente o que todas as lojas baixam e define a unidade em que as velocidades são exibidas. Mbps significa megabits por segundo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即限制所有商店的下载速度，并设置速度的显示单位。Mbps 表示兆比特每秒。"
          }
        }
      }
    },
