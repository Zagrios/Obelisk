    "ui.settings.library_folder_description": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ speichert hier, auf diesem Mac, Ihre Speicherstände, seine Laufzeiten und die Umgebungen Ihrer Windows-Spiele."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ keeps your saves, its runtimes and your Windows games’ environments here, on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ guarda aquí, en este Mac, tus partidas guardadas, sus entornos de ejecución y los entornos de tus juegos de Windows."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ y garde vos sauvegardes, ses runtimes et les environnements de vos jeux Windows, sur ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tiene qui, su questo Mac, i tuoi salvataggi e i suoi runtime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は、セーブデータ、ランタイム、Windowsゲームの環境を、このMacのこの場所に保存します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ guarda aqui, neste Mac, os seus jogos salvos, os ambientes de execução e os ambientes dos seus jogos de Windows."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 将您的存档、它的运行时以及 Windows 游戏的环境保存在这台 Mac 上的此处。"
          }
        }
      }
    },
