          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法安全地归档或验证存档。"
          }
        }
      }
    },
    "backend.steam.cloud.ownership": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese lokalen Speicherstände gehören zu einem anderen Account und konnten nicht sicher gewechselt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These local saves belong to another account and could not be safely switched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas partidas guardadas locales pertenecen a otra cuenta y no se pudieron cambiar de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces sauvegardes locales appartiennent à un autre compte et n’ont pas pu être échangées en toute sécurité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi salvataggi locali appartengono a un altro account e non è stato possibile passarli in modo sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのローカルのセーブデータは別のアカウントのもので、安全に切り替えることができませんでした。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estes jogos salvos locais pertencem a outra conta e não puderam ser trocados com segurança."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些本地存档属于另一个帐户，无法安全切换。"
          }
        }
      }
    },
    "backend.steam.cloud.recovery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein unterbrochener Speichervorgang muss wiederhergestellt werden, bevor es weitergeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An interrupted save operation needs recovery before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que recuperar una operación de guardado interrumpida antes de continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une opération de sauvegarde interrompue doit être récupérée avant de continuer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'operazione sui salvataggi interrotta richiede un recupero prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "続行する前に、中断されたセーブ処理を復旧する必要があります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma operação de salvamento interrompida precisa ser recuperada antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要先恢复一个被中断的存档操作，然后才能继续。"
          }
        }
      }
    },
    "backend.steam.cloud.uncertain": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Synchronisation ist fehlgeschlagen. Ihre lokalen Speicherstände bleiben erhalten. Obelisk versucht es beim nächsten Start erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloud synchronization failed. Your local saves are preserved. Obelisk will try again at the next launch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falló la sincronización con Cloud. Tus partidas guardadas locales se conservan. Obelisk volverá a intentarlo en el próximo inicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation Cloud a échoué. Vos sauvegardes locales sont conservées. Obelisk réessaiera au prochain lancement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sincronizzazione cloud non riuscita. I tuoi salvataggi locali sono al sicuro. Obelisk riproverà al prossimo avvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クラウド同期に失敗しました。ローカルのセーブデータは保持されています。Obeliskは次回の起動時にもう一度同期を試みます。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com a nuvem falhou. Os seus jogos salvos locais foram preservados. O Obelisk tentará novamente na próxima inicialização."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "云同步失败。您的本地存档已保留。Obelisk 将在下次启动时重试。"
          }
        }
      }
    },
    "backend.steam.cloud.changed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Speicherstände haben sich seit dem letzten Vergleich geändert. Versuchen Sie es erneut, um die aktuellen Versionen zu vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saves changed after the last comparison. Retry to compare the current versions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las partidas guardadas cambiaron después de la última comparación. Reinténtalo para comparar las versiones actuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sauvegardes ont changé depuis la dernière comparaison. Réessayez pour comparer les versions actuelles."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I salvataggi sono cambiati dopo l'ultimo confronto. Riprova per confrontare le versioni attuali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の比較後にセーブデータが変更されました。再試行して、現在のデータを比較してください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os jogos salvos mudaram depois da última comparação. Tente novamente para comparar as versões atuais."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "存档在上次比较之后发生了更改。请重试以比较当前版本。"
          }
        }
      }
    },
    "backend.steam.cloud.quota": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam kann diese Speicherstände gerade nicht annehmen. Geben Sie Cloud-Speicher frei oder versuchen Sie es später erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam cannot accept these saves now. Free up Cloud space or retry later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam no puede aceptar estas partidas guardadas ahora. Libera espacio en Cloud o inténtalo de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam ne peut pas accepter ces sauvegardes pour le moment. Libérez de l’espace Cloud ou réessayez plus tard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam non può accettare questi salvataggi ora. Libera spazio nel cloud o riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在、Steamはこれらのセーブデータを受け付けられません。クラウドの空き容量を増やすか、後でもう一度お試しください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Steam não pode aceitar estes jogos salvos agora. Libere espaço na nuvem ou tente novamente mais tarde."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Steam 目前无法接受这些存档。请释放云空间或稍后重试。"
          }
        }
      }
    },
    "ui.cloud.sync_short": {
