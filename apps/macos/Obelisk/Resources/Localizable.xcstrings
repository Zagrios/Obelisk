    "ui.settings.release_return": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stellt beim Beenden seine neueste stabile Version wieder her, oder sofort, wenn Sie die App neu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ puts its latest release back when it quits, or now if you restart it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ recupera su última versión estable al salir, o ahora si lo reinicias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ remettra sa dernière version stable en quittant, ou tout de suite si vous le redémarrez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ rimetterà la sua ultima versione stabile alla chiusura, o subito se lo riavvii."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は終了時に最新の正式版に戻ります。再起動すると、すぐに戻ります。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ restaura a versão estável mais recente ao sair, ou agora, se você o reiniciar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会在退出时恢复为最新的正式版；如果您重启，则立即恢复。"
          }
        }
      }
    },
    "ui.settings.release_return_unwritable": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann sich an seinem Speicherort nicht selbst ersetzen. Laden Sie Version %2$@ herunter und ersetzen Sie diese damit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ cannot replace itself where it is. Download version %2$@ and put it in place of this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no puede reemplazarse a sí mismo donde está. Descarga la versión %2$@ y ponla en lugar de esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas se remplacer là où il se trouve. Téléchargez la version %2$@ et mettez-la à la place de celle-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ non può sostituirsi dove si trova. Scarica la versione %2$@ e mettila al posto di questa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は現在の場所で自身を置き換えることができません。バージョン %2$@をダウンロードして、現在のものと置き換えてください。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %1$@ não consegue substituir a si mesmo onde está. Baixe a versão %2$@ e coloque-a no lugar desta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 无法在当前位置替换自身。请下载 %2$@ 版本并用它替换当前版本。"
          }
        }
      }
    },
