    "backend.steam.cloud.rulesChanged": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cloud-Regeln dieses Spiels haben sich geändert. Installieren Sie es neu, um diesen Speicherstand zu senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game’s Cloud rules changed. Reinstall it to send this save."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas de Cloud de este juego han cambiado. Reinstálalo para enviar esta partida guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les règles Cloud de ce jeu ont changé. Réinstallez-le pour envoyer cette sauvegarde."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
