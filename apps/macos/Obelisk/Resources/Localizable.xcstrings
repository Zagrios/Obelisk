      }
    },
    "backend.epic.cloud.storage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk could not safely read or archive this game’s saves. Check available disk space and folder access, then retry."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk n’a pas pu lire ou archiver les sauvegardes de ce jeu en toute sécurité. Vérifiez l’espace disque et l’accès aux dossiers, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obelisk non ha potuto leggere o archiviare in sicurezza i salvataggi di questo gioco. Controlla lo spazio su disco e l'accesso alle cartelle, poi riprova."
          }
        }
      }
    },
