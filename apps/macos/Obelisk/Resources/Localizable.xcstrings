    "ui.launch_settings.render_percent_detail": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weniger Pixel, mehr FPS. macOS skaliert das Bild hoch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewer pixels, more FPS. macOS scales the picture up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos píxeles, más FPS. macOS amplía la imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de pixels, plus de FPS. macOS agrandit l'image."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Meno pixel, più FPS. macOS ingrandisce l'immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ピクセル数を減らすと、FPSが向上します。映像はmacOSが拡大します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos pixels, mais FPS. O macOS amplia a imagem."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像素越少，FPS 越高。macOS 会放大画面。"
          }
        }
      }
    },
