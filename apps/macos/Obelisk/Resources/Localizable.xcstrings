    "ui.settings.games_outside_description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A game outside it stays playable where it is."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jeu hors du dossier reste jouable là où il est."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un gioco fuori da essa resta giocabile dove si trova."
          }
        }
      }
    },
