    "backend.steam.join.unavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This game cannot be joined right now."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette partie ne peut pas être rejointe pour le moment."
          }
        }
      }
